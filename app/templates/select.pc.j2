    if (SQLCODE!=0 && SQLCODE!=NOTFOUND && SQLCODE!=TOOMANY) {
        MakeErrMsg(message,SVCNAME,DBSEL,SQLMSG);
        TPRETURN_ERROR(message,-1);
    }
    if (SQLCODE==TOOMANY || SQLCNT>MAXROWCNT) {
        MakeMsg(message,SF_B220,MAXROWCNT);
        TPRETURN_ERROR(message,1);
    }
    rowcnt = SQLCNT;
    if (rowcnt<0) {
        MakeErrMsg(message,SVCNAME,DBSEL,SQLMSG);
        TPRETURN_ERROR(message,-1);
    }

    if ((transf=(FBFR *)tprealloc((char *)transf,MAXBUFSIZE))==(FBFR *)NULL) {
        MakeErrMsg(message,SVCNAME,TUXALLOC,TUXMSG);
        TPRETURN_ERROR(message,-1);
    }
    if (Finit(transf,Fsizeof(transf)) == -1) {
        MakeErrMsg(message,SVCNAME,TUXINIT,TUXFMSG);
        TPRETURN_ERROR(message,-1);
    }

    /* NO DATA: preserve the sample's SF_A220 / success return with 0 rows. */
    if (rowcnt==0) {
